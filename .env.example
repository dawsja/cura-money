# ---- App ------------------------------------------------------------------
NODE_ENV=development
# Leave empty for raw-IP / dynamic-host access. Set to your canonical URL
# (no trailing slash) when running behind a reverse proxy on a domain.
APP_URL=
BETTER_AUTH_URL=
OIDC_REDIRECT_BASE=
PORT=3000
LOG_LEVEL=info

# ---- Database -------------------------------------------------------------
POSTGRES_USER=cura
POSTGRES_PASSWORD=change-me-strong-passphrase
POSTGRES_DB=cura
DATABASE_URL=postgresql://cura:change-me-strong-passphrase@db:5432/cura

# ---- Redis ----------------------------------------------------------------
REDIS_URL=redis://redis:6379

# ---- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32  (must be >= 32 chars)
BETTER_AUTH_SECRET=replace-with-32-bytes-of-random-base64

# ---- Cron -----------------------------------------------------------------
# Set RUN_CRON=false if you want to run the SimpleFIN poll + budget roll-
# forward + retention sweep in a separate process and avoid double-execution.
# Cron schedules are HARDCODED in src/jobs/cron.ts to stay inside SimpleFIN's
# documented <=24 reqs/day quota — see the comment block there for rationale.
RUN_CRON=true
